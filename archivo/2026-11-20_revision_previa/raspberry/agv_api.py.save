
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

# Puerto de comunicaciones con la ESP32
PUERTO = 8765

# Sensor de temperatura del procesador
SENSOR = Path("/sys/class/thermal/thermal_zone0/temp")

class ServidorAGV(BaseHTTPRequestHandler):

    def do_GET(self):
        # Solo permitimos consultar la temperatura
        if self.path != "/temperatura":
            self.send_error(404)
            return

        try:
            # Convertir milésimas de grado a °C
            temperatura = int(SENSOR.read_text().strip()) / 1000
            respuesta = f"{temperatura:.1f}"
            self.send_response(200)
        except (OSError, ValueError):
            respuesta = "ERROR"
            self.send_response(503)

        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(respuesta.encode())

# Escuchar conexiones de la red local
servidor = ThreadingHTTPServer(("0.0.0.0", PUERTO), ServidorAGV)

print(f"Servidor AGV activo en puerto {PUERTO}", flush=True)
servidor.serve_forever()

