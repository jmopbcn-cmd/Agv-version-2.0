[Unit]
Description=AGV Car Inteligent - Panel web
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=olmos
WorkingDirectory=/home/olmos/Agv-version-2.0
ExecStart=/home/olmos/Agv-version-2.0/.venv/bin/python -m http.server 8080 --bind 0.0.0.0 --directory /home/olmos/Agv-version-2.0/web
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
